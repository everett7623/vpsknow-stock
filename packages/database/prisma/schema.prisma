generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Provider {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  website   String
  logoUrl   String?
  tier      String   @default("S") // S, A, B
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       Product[]
  affiliateLinks AffiliateLink[]

  @@map("providers")
}

model Product {
  id                 String   @id @default(cuid())
  providerId         String
  productId          String   // external identifier e.g. "buyvm-slice-1024-lv"
  whmcsPid           String?  // WHMCS product ID for affiliate links (e.g. "95" for BandwagonHost)
  planName           String
  category           String   // vps, vds, dedicated, nat_vps, storage
  location           String
  cpu                String?
  ramMb              Int?
  storageGb          Int?
  storageType        String?
  bandwidthTb        Float?
  /// Display override for bandwidth (e.g. "Unmetered") when numeric TB is 0/ambiguous
  bandwidthLabel     String?
  /// Normalized network route label, e.g. CN2 GIA, CMIN2, or Premium
  lineType           String?
  ipv4               Boolean?
  /// live = last stock claim from a live adapter check; catalog = published catalog only
  availabilitySource String   @default("live")
  priceCents         Int
  currency           String   @default("USD")
  billingCycle       String   @default("monthly")
  inStock            Boolean  @default(false)
  lastStockChangeAt  DateTime?
  lastCheckedAt      DateTime?
  consecutiveConfirm Int      @default(0)
  orderUrl           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  provider    Provider     @relation(fields: [providerId], references: [id])
  stockChecks StockCheck[]
  stockEvents StockEvent[]

  @@unique([providerId, productId])
  @@index([inStock])
  @@index([providerId, inStock])
  @@index([providerId, priceCents])
  @@index([providerId, lastCheckedAt])
  @@index([ipv4])
  @@map("products")
}

model StockCheck {
  id         String   @id @default(cuid())
  productId  String
  inStock    Boolean
  priceCents Int?
  responseMs Int?
  error      String?
  raw        Json?
  checkedAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, checkedAt])
  @@index([checkedAt])
  @@map("stock_checks")
}

model StockEvent {
  id         String   @id @default(cuid())
  productId  String
  eventType  String   // restock, sold_out
  detectedAt DateTime @default(now())
  notified   Boolean  @default(false)
  metadata   Json?

  product          Product          @relation(fields: [productId], references: [id])
  telegramMessages TelegramMessage[]

  @@index([productId, detectedAt])
  @@index([eventType, detectedAt])
  @@index([detectedAt])
  @@map("stock_events")
}

model AffiliateLink {
  id            String    @id @default(cuid())
  providerId    String
  slug          String    @unique // e.g. "buyvm-slice-1024-lv"
  targetUrl     String
  shortUrl      String // go.uukk.de/...
  clicks        Int       @default(0)
  lastClickedAt DateTime?

  provider    Provider         @relation(fields: [providerId], references: [id])
  clickEvents AffiliateClick[]

  @@map("affiliate_links")
}

model AffiliateClick {
  id              String   @id @default(cuid())
  affiliateLinkId String
  clickedAt       DateTime @default(now())
  referer         String?
  userAgent       String?

  affiliateLink AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)

  @@index([clickedAt])
  @@index([affiliateLinkId, clickedAt])
  @@map("affiliate_clicks")
}

model TelegramMessage {
  id           String   @id @default(cuid())
  channelId    String
  messageId    Int
  stockEventId String?
  content      String
  sentAt       DateTime @default(now())
  status       String   @default("sent") // sent, failed, deleted

  stockEvent StockEvent? @relation(fields: [stockEventId], references: [id])

  @@index([channelId, sentAt])
  @@index([sentAt])
  @@map("telegram_messages")
}

model Offer {
  id             String   @id @default(cuid())
  source         String   // lowendtalk, lowendbox, lowendspirit, provider_blog, manual
  sourceId       String?  @unique // source-specific ID; external sources use a namespace prefix
  provider       String?
  title          String
  body           String?
  category       String?  // vps, dedicated, nat_vps, storage
  locations      String[] // array of location names
  priceCents     Int?
  currency       String?
  billingCycle   String?
  couponCode     String?
  orderUrl       String?
  threadUrl      String?
  ipv4           Boolean?
  isLimitedStock Boolean  @default(false)
  isRecurring    Boolean  @default(false)
  isPreorder     Boolean  @default(false)
  confidence     Float    @default(0)
  pushed         Boolean  @default(false)
  postedAt       DateTime?
  discoveredAt   DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([source, discoveredAt])
  @@index([pushed, confidence])
  @@index([ipv4])
  @@index([confidence, postedAt])
  @@index([provider, postedAt])
  @@index([category, postedAt])
  @@index([isLimitedStock, postedAt])
  @@index([priceCents])
  @@map("offers")
}

model Subscription {
  id            String   @id @default(cuid())
  telegramUserId BigInt  @unique
  chatId        BigInt
  providers     String[] // provider slugs, empty = all
  regions       String[] // region names, empty = all
  categories    String[] // product categories, empty = all
  maxPriceCents Int?     // null = no limit
  eventTypes    String[] // restock, offers, or both
  isActive      Boolean  @default(true)
  mutedUntil    DateTime?
  lastNotifiedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, mutedUntil])
  @@index([lastNotifiedAt])
  @@map("subscriptions")
}
